{
  "name": "aem-kit",
  "version": "0.12.0",
  "description": "Toolchain HTML-first + Tailwind para projetos AEM Edge Delivery (xwalk): init, geração de blocos, build e validações de pre-commit (incluindo Lighthouse).",
  "type": "module",
  "bin": {
    "aem-kit": "bin/aem-kit.mjs"
  },
  "files": [
    "bin",
    "src",
    "templates",
    "schema"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "eslint src bin --ext .mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/victormarques-cogna/aem-kit.git"
  },
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "eslint": "8.57.1",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-plugin-import": "2.32.0"
  },
  "aemKit": {
    "packageSpec": "git+https://github.com/victormarques-cogna/aem-kit.git#v{version}",
    "projectDevDependencies": {
      "@axe-core/playwright": "4.14.0",
      "@babel/core": "^7.29.13",
      "@tailwindcss/cli": "^4.3.5",
      "html-validate": "10.17.0",
      "lighthouse": "13.6.0",
      "playwright": "1.64.1",
      "prettier": "^3.10.1",
      "prettier-plugin-tailwindcss": "^0.8.1",
      "tailwindcss": "^4.3.5"
    }
  }
}
