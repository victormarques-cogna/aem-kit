{
  "extends": ["stylelint-config-standard"],
  "overrides": [
    {
      "files": ["styles/tailwind.css", "components/**/*.css"],
      "rules": {
        "import-notation": null,
        "at-rule-empty-line-before": null,
        "custom-property-pattern": null,
        "color-hex-length": null,
        "at-rule-no-unknown": [
          true,
          {
            "ignoreAtRules": [
              "theme",
              "source",
              "utility",
              "variant",
              "custom-variant",
              "plugin",
              "apply",
              "reference",
              "config",
              "tailwind"
            ]
          }
        ]
      }
    }
  ]
}
